{
  "schema_version": "1.0",
  "title": "IINTS-AF regenerative islet research protein panels",
  "scope": "Research-only evidence panels for stem-cell-derived islet identity, function, graft survival, immune interaction, and safety.",
  "scientific_boundaries": {
    "research_only": true,
    "automatic_physiology_mapping_allowed": false,
    "alphafold_is_structure_confidence_only": true,
    "network_scores_are_not_causal_effects": true,
    "protein_markers_are_not_patient_outcomes": true,
    "unknown_or_conflicting_evidence_fails_closed": true
  },
  "forbidden_inferences": [
    "AlphaFold pLDDT or PAE to treatment efficacy",
    "AlphaFold pLDDT or PAE to insulin sensitivity",
    "STRING confidence to causal effect size",
    "protein abundance to clinical benefit without functional validation",
    "variant classification to physiological effect size without functional evidence",
    "immune-evasion marker to transplant safety",
    "any single score to a cure claim"
  ],
  "evidence_sources": {
    "canonical_annotation": ["UniProt"],
    "experimental_structure": ["RCSB PDB"],
    "predicted_structure": ["AlphaFold Protein Structure Database"],
    "single_cell_expression": ["CELLxGENE Discover", "Human Pancreas Analysis Program"],
    "tissue_expression": ["Human Protein Atlas", "Bgee", "GTEx"],
    "quantitative_proteomics": ["PRIDE Archive", "ProteomeXchange"],
    "pathway_context": ["Reactome", "STRING"],
    "measured_binding": ["BindingDB", "ChEMBL"],
    "functional_assay": ["Curated primary literature", "Independent laboratory assay"],
    "immune_challenge_assay": ["Curated primary literature", "Independent immune-cell assay"],
    "in_vivo_graft_evidence": ["Curated primary literature", "Registered pre-clinical study"],
    "clinical_evidence": ["ClinicalTrials.gov", "Peer-reviewed clinical publication"],
    "tumorigenicity_assay": ["Independent laboratory assay", "Registered pre-clinical study"],
    "longitudinal_stability": ["Independent laboratory assay", "Longitudinal graft study"]
  },
  "seed_datasets": [
    {
      "accession": "PXD001539",
