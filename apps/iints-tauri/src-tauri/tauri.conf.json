{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IINTS-AF Research Workbench",
  "version": "0.2.12",
  "identifier": "org.iints.research-workbench",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "IINTS-AF Research Workbench",
        "width": 1240,
        "height": 820,
        "minWidth": 600,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "devtools": false,
        "fullscreen": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/python35/IINTS-SDK/releases/download/tauri-beta-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNzM4MkY3NjI1RjY5OTAKUldTUWFWOWk5NEp6RTJiZHZ1Tlo1SXd3ZXhtRlpvOWJ6SThFN2RuVnBxd1BWRVArNDZhbUZ3UnUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Research-only desktop shell for IINTS-AF",
    "longDescription": "A native research workbench for running IINTS-AF SDK simulations, previewing generated outputs, and checking local AI readiness. Not a medical device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
